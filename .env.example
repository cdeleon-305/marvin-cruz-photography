# Site Configuration
NEXT_PUBLIC_SITE_URL=https://yoursite.com
NEXT_PUBLIC_SITE_NAME="Your Name Photography"
NEXT_PUBLIC_CONTACT_EMAIL=your.email@example.com

# Site Protection (optional - remove this to make site public)
